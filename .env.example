# Copier ce fichier en ".env" et adapter si besoin.
# Laisser "/api" pour utiliser le proxy Vite (recommande en developpement).
# Mettre une URL complete (ex: http://localhost:8080/api) pour taper le backend en direct.
VITE_API_URL=/api

# Adresse de l'API du camarade sur le reseau local (machine + port HTTPS).
# Port 8443 = server.port dans application.properties de l'API (keystore.p12).
# Utilisee uniquement cote serveur (vite.config.js) pour rediriger "/api/...",
# jamais exposee au navigateur.
VITE_API_PROXY_TARGET=https://192.168.100.197:8443

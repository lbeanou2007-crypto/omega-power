package com.lagon.restapi.controller;

import com.lagon.restapi.model.Statut;
import com.lagon.restapi.service.StatutService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Optional;

@CrossOrigin(origins = "http://localhost:5173")
@RestController
@RequestMapping("/api/statuts")
public class StatutController {

    @Autowired
    private StatutService statutService;

    // GET ALL → /api/statuts
    @GetMapping
    public List<Statut> getAllStatuts() {
        return statutService.getAllStatuts();
    }

    // GET BY ID → /api/statuts/{id}
    @GetMapping("/{id}")
    public ResponseEntity<Statut> getStatutById(@PathVariable Long id) {
        Optional<Statut> statut = statutService.getStatutById(id);
        return statut.map(ResponseEntity::ok)
                     .orElseGet(() -> ResponseEntity.notFound().build());
    }

    // POST → /api/statuts
    @PostMapping
    public Statut createStatut(@RequestBody Statut statut) {
        return statutService.createStatut(statut);
    }

    // PUT → /api/statuts/{id}
    @PutMapping("/{id}")
    public ResponseEntity<Statut> updateStatut(@PathVariable Long id,
                                                @RequestBody Statut statutDetails) {
        return statutService.updateStatut(id, statutDetails)
                .map(ResponseEntity::ok)
                .orElseGet(() -> ResponseEntity.notFound().build());
    }

    // DELETE → /api/statuts/{id}
    @DeleteMapping("/{id}")
    public ResponseEntity<Void> deleteStatut(@PathVariable Long id) {
        if (statutService.deleteStatut(id)) {
            return ResponseEntity.noContent().build();
        }
        return ResponseEntity.notFound().build();
    }
}